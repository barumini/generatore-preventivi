# GibusRender: variabili d'ambiente. Copiare in `.env` (vedi README) e compilare.
# Non inserire mai chiavi reali in questo file: è nel repository.
#
# Quale file legge quale comando:
#   - `.env`        letto da `next dev`, `prisma migrate`, `npm run db:seed` (questi ultimi due leggono SOLO `.env`)
#   - `.env.local`  letto solo da Next (dev/build): non usarlo per Prisma e seed

# Database PostgreSQL (Neon o Postgres locale), obbligatoria.
# Esempio locale: postgresql://gibus:gibus@localhost:5432/gibusrender
# Esempio Neon:   postgresql://utente:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://utente:password@localhost:5432/gibusrender

# Vercel Blob (foto, maschere, render). Obbligatoria in produzione.
# In sviluppo è facoltativa: se vuota, i file vanno in GibusRender/.data/
BLOB_READ_WRITE_TOKEN=

# Utenti Basic Auth, formato utente:password,utente2:password2
# Le password NON possono contenere virgole (la virgola separa gli utenti).
# Se vuota: 503 in produzione, accesso libero in sviluppo.
BASIC_AUTH_USERS=mario:cambia-questa-password

# Chiavi dei fornitori di immagini (si abilita solo il fornitore con la chiave presente)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Modelli OpenRouter suggeriti nelle Impostazioni, separati da virgola (facoltativa).
# Se vuota: google/gemini-2.5-flash-image
OPENROUTER_MODELS=

# Chiave API di Google Gemini (Google AI Studio, https://aistudio.google.com/apikey).
# Modelli consigliati: gemini-3-pro-image (qualità), gemini-3.1-flash-image (più economico).
GEMINI_API_KEY=

# URL pubblico dell'app, inviato a OpenRouter come HTTP-Referer (facoltativa).
# Se vuota: su Vercel si usa VERCEL_PROJECT_PRODUCTION_URL (impostata da Vercel), altrimenti http://localhost:3000
APP_URL=
