# Fornitore AI per l'estrazione dei campi: 'openrouter' | 'lmstudio'.
# Se omesso: OpenRouter quando OPENROUTER_API_KEY è impostata, altrimenti LM Studio.
AI_PROVIDER=

# --- OpenRouter (API esterna, https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Facoltativo: elenco di modelli separati da virgole, il primo è il principale e i successivi
# le riserve (OpenRouter passa al successivo se il precedente non risponde).
# Default: openai/gpt-6-luna,qwen/qwen3.8-flash — scelti con la valutazione descritta in
# docs/valutazione-modelli-estrazione.md: cambiarli senza rivalutare invalida le misure.
OPENROUTER_MODEL=
# Facoltativo: 'on' accende il ragionamento del modello (più lento e costoso), default spento.
# I modelli di default sono stati valutati a ragionamento spento.
OPENROUTER_REASONING=

# --- LM Studio (locale, offline) ---
# URL del server locale di LM Studio (Impostazioni > Local Server > Start Server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Nome esatto del modello caricato in LM Studio (visibile nell'interfaccia)
LM_STUDIO_MODEL=
